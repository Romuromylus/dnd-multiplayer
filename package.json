{
  "name": "dnd-table",
  "version": "2.0.0",
  "private": true,
  "description": "A D&D 5e table for a group of players with an AI Dungeon Master: everyone posts what their character does, the Dungeon Master writes the round.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@breezystack/lamejs": "^1.2.7",
    "@hono/node-server": "^2.1.5",
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.14",
    "kokoro-js": "^1.2.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
