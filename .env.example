# Where the database, pictures and backups live.
DATA_DIR=./data
PORT=3000
# Secret that encrypts the stored API keys. Without it, one is made and kept in DATA_DIR/.master_key.
DND_MASTER_KEY=
# Plain http on localhost: leave the session cookie without the Secure flag.
DND_INSECURE_COOKIES=1
# Optional first account (otherwise the first person to sign up is the admin).
DND_ADMIN_USER=
DND_ADMIN_PASSWORD=
# Optional default connections, seeded once on first boot.
DND_WRITER_ENDPOINT=
DND_WRITER_KEY=
DND_WRITER_MODEL=claude-opus-5-5
DND_RECORDS_MODEL=claude-sonnet-5-5
# Optional pictures: an OpenAI-compatible image endpoint.
DND_IMAGES_ENDPOINT=
DND_IMAGES_KEY=
DND_IMAGES_MODEL=gpt-image-2-c
